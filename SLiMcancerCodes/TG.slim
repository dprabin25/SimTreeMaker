//SLiM version 5.1
//
// TG - TumorGrowth, single-population clonal growth model (nonWF).
//
// MODEL
//   Diploid cells reproduce clonally with no recombination. Every cell
//   produces one clone per tick, and density-dependent viability selection
//   (fitnessScaling) holds driver-free cells near targetSize. Fitness is
//   absolute survival here, so each driver (1 + h*s per copy) also raises
//   its clone's effective carrying capacity. The genome has two
//   non-overlapping regions:
//     g1  [m1Start, m1End]  neutral background mutations (m1) at mutationRate
//     g2  [m2Start, m2End]  driver mutations (m2) at driverMutationRate
//   Regions may be in either order; positions outside both never mutate.
//   Every driver arises spontaneously - none is placed by hand.
//
// TICK CYCLE (nonWF)
//   reproduction() -> early() -> fitness/viability -> late()
//
// PARAMETERS (all required, passed with -d; see config.txt)
//   initialPopSize, targetSize, mutationRate, driverMutationRate,
//   m1Start, m1End, m2Start, m2End, m2_dominance, m2_effect,
//   simulationEndTick, treesPath
//
// RUN
//   Normally via `python simtreemaker.py` (reads config.txt). Directly:
//     slim -d initialPopSize=1 -d targetSize=150 \
//          -d mutationRate=1e-8 -d driverMutationRate=1e-8 \
//          -d m1Start=0 -d m1End=49999 -d m2Start=50000 -d m2End=99999 \
//          -d m2_dominance=0.5 -d m2_effect=0.6 \
//          -d simulationEndTick=200 -d treesPath="'TG.trees'" TG.slim
//
// MIGRATION
//   This file never migrates. `python simtreemaker.py migration` builds a
//   temporary variant by inserting code at the marker in early() below.

initialize() {
    initializeSLiMModelType("nonWF");
    initializeTreeSeq();

    // ---- Validate genome layout ----
    if (!isInteger(m1Start) | !isInteger(m1End) | !isInteger(m2Start) | !isInteger(m2End))
        stop("m1Start, m1End, m2Start and m2End must be integers.");
    if (m1Start < 0 | m2Start < 0)
        stop("Region starts must be >= 0.");
    if (m1Start > m1End)
        stop("m1Start (" + m1Start + ") must be <= m1End (" + m1End + ").");
    if (m2Start > m2End)
        stop("m2Start (" + m2Start + ") must be <= m2End (" + m2End + ").");
    if (m1Start <= m2End & m2Start <= m1End)
        stop("m1 [" + m1Start + "-" + m1End + "] and m2 [" + m2Start + "-" + m2End + "] overlap.");

    // ---- Mutation types ----
    initializeMutationType("m1", 0.5, "f", 0.0);            // neutral background
    initializeMutationType("m2", m2_dominance, "f", m2_effect);  // driver
    m1.convertToSubstitution = F;
    m2.convertToSubstitution = F;

    // ---- Genome ----
    initializeGenomicElementType("g1", m1, 1.0);
    initializeGenomicElementType("g2", m2, 1.0);
    initializeGenomicElement(g1, m1Start, m1End);
    initializeGenomicElement(g2, m2Start, m2End);

    // Rate map ends must be ascending, so order the two regions by position.
    // Each segment runs up to its region's end; gap positions have no
    // genomic element and so never mutate regardless of the rate there.
    if (m1End < m2Start)
        initializeMutationRate(c(mutationRate, driverMutationRate), c(m1End, m2End));
    else
        initializeMutationRate(c(driverMutationRate, mutationRate), c(m2End, m1End));

    initializeRecombinationRate(0);
}

1 early() {
    sim.addSubpop("p1", initialPopSize);
    // The run lasts until the last scheduled tick, so move the output block
    // to simulationEndTick (tick ranges cannot reference -d constants).
    community.rescheduleScriptBlock(s1, start=simulationEndTick, end=simulationEndTick);
}

reproduction() {
    // One clone per cell per tick; parents are not removed here.
    subpop.addCloned(individual);
}

early() {
    // Runs after reproduction, so n counts parents + this tick's offspring.
    // Survival = min(1, fitness * targetSize / n), so driver-free cells
    // settle at targetSize and driver clones above it.
    n = p1.individualCount;
    p1.fitnessScaling = targetSize / n;
    ////////////////////////////////
    //Add migration setting if any//
    ////////////////////////////////
}

s1 2 late() {
    sim.treeSeqOutput(treesPath);
    catn("SLiM done. Tree written to: " + treesPath);
    sim.simulationFinished();
}
